<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Supprocom.LlamaSharp.ToolCallEnvelopes</PackageId>
    <AssemblyName>LlamaSharp.ToolCallEnvelopes</AssemblyName>
    <RootNamespace>LlamaSharp.ToolCallEnvelopes</RootNamespace>
    <Version>0.2.1</Version>
    <Authors>mkn8rn</Authors>
    <Title>LlamaSharp Tool Call Envelopes</Title>
    <PackageLicenseFile>PACKAGE-LICENSE.txt</PackageLicenseFile>
    <Description>Commercial or AGPL-3.0. Reliable LlamaSharp tool calling with a compiled JSON contract, manual turns, and managed orchestration.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>llamasharp;llama.cpp;tool-calling;gbnf;json-schema</PackageTags>
    <PackageReleaseNotes>Dual-licensed: Commercial or AGPL-3.0. Adds the Supprocom Commercial License as an alternative to the AGPL-3.0.
Security support until November 2031</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/Supprocom/LlamaSharp.ToolCallEnvelopes</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Supprocom/LlamaSharp.ToolCallEnvelopes</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <NoWarn>$(NoWarn);CS1574</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="LICENSE" />
    <None Include="..\NOTICE" Pack="true" PackagePath="NOTICE" />
  </ItemGroup>

  <!-- The package license file is generated from the repository's COMMERCIAL-LICENSE and LICENSE files. -->
  <PropertyGroup>
    <SupprocomPackageLicensePath>$(BaseIntermediateOutputPath)PACKAGE-LICENSE.txt</SupprocomPackageLicensePath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(SupprocomPackageLicensePath)" Pack="true" PackagePath="PACKAGE-LICENSE.txt" Visible="false" />
  </ItemGroup>
  <Target Name="WriteSupprocomPackageLicense" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <PropertyGroup>
      <_SupprocomCommercialText>$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../COMMERCIAL-LICENSE').TrimEnd())))</_SupprocomCommercialText>
      <_SupprocomAgplText>$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../LICENSE').TrimEnd())))</_SupprocomAgplText>
      <_SupprocomPackageLicenseText>Commercial or AGPL-3.0

This package is available under your choice of two licenses:
- the Supprocom Commercial License 1.0, for businesses with a registered Supprocom sponsorship (https://github.com/sponsors/Supprocom)%3B or
- the GNU Affero General Public License, version 3 (AGPL-3.0).

Both texts follow. For each version, the COMMERCIAL-LICENSE file in the project's GitHub repository at the commit this package was built from prevails over this copy.

==============================================================================
$(_SupprocomCommercialText)

==============================================================================
$(_SupprocomAgplText)</_SupprocomPackageLicenseText>
    </PropertyGroup>
    <WriteLinesToFile File="$(SupprocomPackageLicensePath)" Lines="$(_SupprocomPackageLicenseText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
